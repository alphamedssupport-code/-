# ==============================================================
# LINEハーネス 丸投げ集客サービス — 環境変数サンプル
# このファイルをコピーして .env を作成し、実際の値を設定してください
# cp .env.example .env
# ==============================================================

# --------------------------------------------------------------
# LINE Messaging API 設定（必須）
# LINE Developersコンソール > チャネル設定 から取得
# --------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --------------------------------------------------------------
# 担当者通知先 LINE ID 設定（必須）
# LINE Developers > チャネル > ユーザーID から取得
# または LINE公式アカウントのグループIDを設定
# --------------------------------------------------------------

# デフォルト担当者のLINEユーザーID（U + 32文字の英数字）
AGENT_LINE_USER_ID=

# 担当者グループに通知する場合はグループIDを設定（任意）
AGENT_LINE_GROUP_ID=

# エリア・種別別の担当者ID（任意 / agent-routing.json のルールと対応）
AGENT_TOKYO_BUY_LINE_USER_ID=
AGENT_KANAGAWA_BUY_LINE_USER_ID=
AGENT_SELL_MANSION_LINE_USER_ID=
AGENT_SELL_HOUSE_LINE_USER_ID=
AGENT_RENT_LINE_USER_ID=

# --------------------------------------------------------------
# サーバー設定
# --------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Webhookのベースドメイン（HTTPS必須）
# 例: https://your-app.railway.app
BASE_URL=

# --------------------------------------------------------------
# セッション・状態管理（Redis）
# --------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Redis接続タイムアウト（ミリ秒）
REDIS_CONNECT_TIMEOUT=5000

# ユーザーセッションの有効期限（秒）/ デフォルト30日
SESSION_TTL_SECONDS=2592000

# --------------------------------------------------------------
# データベース（リード永続化）
# --------------------------------------------------------------
# PostgreSQL接続文字列
DATABASE_URL=postgresql://user:password@localhost:5432/realestatebot

# SQLiteを使う場合（開発環境向け）
# DATABASE_URL=file:./dev.db

# --------------------------------------------------------------
# ナーチャリングスケジューラー
# --------------------------------------------------------------
# バッチ処理の実行スケジュール（cron形式）
# デフォルト: 毎朝8時に実行
NURTURE_CRON_SCHEDULE=0 8 * * *

# COLDリード日次バッチの送信時刻（HH:MM形式）
COLD_LEAD_BATCH_TIME=09:00

# --------------------------------------------------------------
# CRM連携（任意）
# --------------------------------------------------------------
# リード情報をCRMに自動登録する場合に設定
CRM_WEBHOOK_URL=
CRM_API_KEY=

# --------------------------------------------------------------
# ログ設定
# --------------------------------------------------------------
LOG_LEVEL=info
